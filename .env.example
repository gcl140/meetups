# Copy this file to .env and fill in real values for your environment.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Email (defaults to console backend in DEBUG so nothing needs to be set for local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Meetups <noreply@meetups.local>

# Optional: enables the embedded Google Map on event pages.
# Without it, event pages still show an "Open in Google Maps" link.
GOOGLE_MAPS_API_KEY=

# How often (minutes) the in-process scheduler checks for reminder/deadline emails to send.
REMINDER_POLL_MINUTES=5

SITE_URL=http://127.0.0.1:8000
